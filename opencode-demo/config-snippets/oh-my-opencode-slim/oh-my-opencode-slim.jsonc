{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",

  // 这是分享用配置，请先用 opencode models --refresh 检查模型是否可用。
  "preset": "team-demo",

  "presets": {
    "team-demo": {
      // 编排者负责规划和判断，使用能力较强的模型。
      "orchestrator": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "skills": ["*"],
        "mcps": []
      },

      // 架构顾问使用强推理模型。
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high",
        "skills": ["simplify"],
        "mcps": []
      },

      // 搜索和实现任务使用更快、更经济的模型。
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": ["context7", "gh_grep"]
      },
      "explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },
      "designer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "high",
        "skills": [],
        "mcps": []
      }
    }
  }
}
